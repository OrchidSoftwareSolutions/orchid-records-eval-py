{
  "name": "Records",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "make setup",
  "postAttachCommand": "curl -sf http://127.0.0.1:8000/health >/dev/null && echo 'Servers already running.' || make dev",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "Frontend", "onAutoForward": "openBrowser" },
    "8000": { "label": "Backend", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
